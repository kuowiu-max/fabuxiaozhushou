{
  "name": "publish-helper",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "可导入 AI 的门店文案、评论照片及大众点评分成规则核对技能",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "test": "node --test test/*.test.mjs",
    "test:materials": "python3 -B -m unittest discover -s test -p '*_test.py'"
  }
}
